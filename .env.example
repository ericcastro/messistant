# The admin server stays on localhost by default.
MESSISTANT_HOST=127.0.0.1
MESSISTANT_PORT=3000
MESSISTANT_DATA_DIR=./data
MESSISTANT_LOG_LEVEL=info

# Recommended secret configuration. A key saved in the admin UI is encrypted
# locally instead. Environment configuration takes precedence.
OPENAI_API_KEY=

# Only needed in containers or environments where Chromium cannot use a sandbox.
PUPPETEER_NO_SANDBOX=false

